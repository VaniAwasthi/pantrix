# Local development (SQLite — no cloud DB needed)
DATABASE_URL="file:./dev.db"

# For Vercel production, switch prisma/schema.prisma provider to "postgresql"
# and use Neon / Supabase / Vercel Postgres:
# DATABASE_URL="postgresql://user:password@host:5432/pantrix?sslmode=require"

# JWT secret for auth cookies (generate a random string for production)
JWT_SECRET="change-this-to-a-long-random-string-in-production"
